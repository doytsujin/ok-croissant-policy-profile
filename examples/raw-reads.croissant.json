  "@type": "sc:Dataset",
  "name": "raw-reads",
  "description": "sequencing_reads described as a policy-bearing Croissant dataset. State: QC_PASSED. Source: nf-core/test-datasets (viralrecon illumina amplicon samplesheet).",
  "conformsTo": [
    "http://mlcommons.org/croissant/1.0",
    "https://example.invalid/croissant-policy/0.1.0"
  ],
  "version": "1.2.0",
  "url": "https://github.com/nf-core/test-datasets",
  "license": "https://spdx.org/licenses/MIT.html",
  "creator": {
    "@type": "sc:Organization",
    "name": "nf-core"
  },
  "additionalType": "sequencing_reads",
  "dataCollection": "nf-core/test-datasets (viralrecon illumina amplicon samplesheet)",
  "variableMeasured": [
    {
      "@type": "sc:PropertyValue",
      "name": "assay",
      "value": "amplicon"
    },
    {
      "@type": "sc:PropertyValue",
      "name": "layout",
      "value": "paired"
    },
    {
      "@type": "sc:PropertyValue",
      "name": "platform",
      "value": "illumina"
    }
  ],
  "distribution": [
    {
      "@type": "cr:FileSet",
      "@id": "raw-reads-files",
      "name": "raw-reads-files",
      "description": "The sequencing_reads files of this dataset, in fastq.gz form. The native descriptor records the shape of the data and not its location, so this FileSet has no containedIn; the location is supplied by whoever mounts the dataset.",
      "encodingFormat": "application/gzip",
      "includes": "*.fastq.gz"
    },
    {
      "@type": "cr:FileObject",
      "@id": "decisions.jsonl",
      "name": "decisions.jsonl",
      "description": "Decision records emitted by the gate for this dataset.",
      "encodingFormat": "application/jsonl",
      "contentUrl": "decisions.jsonl"
    }
  ],
  "cpol:policy": {
    "@type": "cpol:Policy",
    "cpol:state": "QC_PASSED",
    "cpol:failClosed": true,
    "cpol:classification": "public-test-data",
    "cpol:custodian": "nf-core",
    "cpol:retentionDays": 730,
    "cpol:rationale": "Public nf-core test data. The conditions below are the shape of a regulated descriptor, applied to data that carries no restriction, so the artifact can be run and re-run by anyone.",
    "cpol:permissibleAction": [
      {
        "@type": "cpol:Action",
        "cpol:actionName": "qc",
        "cpol:requiresState": [
          "RECEIVED",
          "QC_PASSED"
        ],
        "cpol:condition": [
          {
            "@type": "cpol:Condition",
            "cpol:conditionName": "platform",
            "cpol:operator": "cpol:in",
            "cpol:expected": [
              "illumina"
            ]
          }
        ]
      },
      {
        "@type": "cpol:Action",
        "cpol:actionName": "trim",
        "cpol:requiresState": [
          "QC_PASSED"
        ],
        "cpol:condition": [
          {
            "@type": "cpol:Condition",
            "cpol:conditionName": "minReadLength",
            "cpol:operator": "cpol:min",
            "cpol:expected": 20
          },
          {
            "@type": "cpol:Condition",
            "cpol:conditionName": "platform",
            "cpol:operator": "cpol:in",
            "cpol:expected": [
              "illumina"
            ]
          }
        ]
      },
      {
        "@type": "cpol:Action",
        "cpol:actionName": "align",
        "cpol:requiresState": [
          "TRIMMED"
        ],
        "cpol:condition": [
          {
            "@type": "cpol:Condition",
            "cpol:conditionName": "minMapQ",
            "cpol:operator": "cpol:min",
            "cpol:expected": 30
          },
          {
            "@type": "cpol:Condition",
            "cpol:conditionName": "referenceBuild",
            "cpol:operator": "cpol:in",
            "cpol:expected": [
              "GRCh38"
            ]
          }
        ]
      }
    ],
    "cpol:decisionRecord": {
      "@id": "decisions.jsonl"
    }
  }
}
