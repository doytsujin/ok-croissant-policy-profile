  "@type": "sc:Dataset",
  "name": "qc-report",
  "description": "quality_report described as a policy-bearing Croissant dataset. State: PENDING.",
  "conformsTo": [
    "http://mlcommons.org/croissant/1.0",
    "https://w3id.org/croissant-policy/0.1.0"
  ],
  "version": "1.0.0",
  "url": "https://github.com/nf-core/test-datasets",
  "license": "https://spdx.org/licenses/MIT.html",
  "creator": {
    "@type": "sc:Organization",
    "name": "nf-core"
  },
  "additionalType": "quality_report",
  "isBasedOn": [
    "raw-reads@1.2.0",
    "trimmed-reads@1.1.0"
  ],
  "measurementTechnique": "MULTIQC",
  "variableMeasured": [
    {
      "@type": "sc:PropertyValue",
      "name": "producer",
      "value": "multiqc"
    }
  ],
  "distribution": [
    {
      "@type": "cr:FileSet",
      "@id": "qc-report-files",
      "name": "qc-report-files",
      "description": "The quality_report files of this dataset, in html+zip form. The native descriptor records the shape of the data and not its location, so this FileSet has no containedIn; the location is supplied by whoever mounts the dataset.",
      "encodingFormat": "application/octet-stream",
      "includes": "*.html+zip"
    },
    {
      "@type": "cr:FileObject",
      "@id": "decisions_gated.jsonl",
      "name": "decisions_gated.jsonl",
      "description": "Decision records emitted by the gate for this dataset.",
      "encodingFormat": "application/jsonl",
      "contentUrl": "decisions_gated.jsonl",
      "sha256": "e3d9d60e43b2742a43018e1ca45a8578d334fc2c7822fd53513dd55f6825e0dd"
    }
  ],
  "cpol:policy": {
    "@type": "cpol:Policy",
    "cpol:state": "PENDING",
    "cpol:failClosed": true,
    "cpol:classification": "public-test-data",
    "cpol:custodian": "nf-core",
    "cpol:retentionDays": 365,
    "cpol:rationale": "Aggregation is the stage where a reader first sees results, so it is the stage most worth gating on completeness of its inputs.",
    "cpol:permissibleAction": [
      {
        "@type": "cpol:Action",
        "cpol:actionName": "aggregate",
        "cpol:requiresState": [
          "PENDING"
        ],
        "cpol:condition": [
          {
            "@type": "cpol:Condition",
            "cpol:conditionName": "minInputStages",
            "cpol:operator": "cpol:min",
            "cpol:expected": 2
          },
          {
            "@type": "cpol:Condition",
            "cpol:conditionName": "reportFormat",
            "cpol:operator": "cpol:in",
            "cpol:expected": [
              "multiqc"
            ]
          }
        ]
      },
      {
        "@type": "cpol:Action",
        "cpol:actionName": "release",
        "cpol:requiresState": [
          "COMPLETE"
        ],
        "cpol:condition": [
          {
            "@type": "cpol:Condition",
            "cpol:conditionName": "approvedBy",
            "cpol:operator": "cpol:present",
            "cpol:expected": true
          }
        ]
      }
    ],
    "cpol:decisionRecord": {
      "@id": "decisions_gated.jsonl"
    }
  }
}
