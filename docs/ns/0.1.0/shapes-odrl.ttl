# SHACL shapes for the ODRL carrier of the Croissant Policy Profile 0.1.0
#
# Generated by croissant_policy/shapes.py. Do not edit.
#
# The carrier is a profile in its own right, with its own identifier, so it gets
# its own shapes: a document claiming it is not a cpol: document and must not be
# validated as one. Section 10 of SPEC.md defines the carrier; these are the
# static half of the same clauses shapes.ttl covers for the cpol: form.
#
# One notational difference from shapes.ttl, and it is instructive. There, the
# operator is a string literal under a global "@language", so the closed set has
# to be checked with sh:pattern -- sh:in compares RDF terms and "cpol:min"@en is
# not the term "cpol:min". Here the operator is written as a node reference and
# expands to an IRI, so sh:in works directly. The ODRL carrier is the better RDF
# of the two, which is worth saying plainly given that the cpol: form is the
# normative one.

@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:      <http://purl.org/dc/terms/> .
@prefix sc:       <https://schema.org/> .
@prefix odrl:     <http://www.w3.org/ns/odrl/2/> .
@prefix cpolodrl: <https://w3id.org/croissant-policy/0.1.0/odrl#> .
@prefix cposh:    <https://w3id.org/croissant-policy/0.1.0/odrl#shapes/> .

#-----------------------------------------------------------------------------
# The dataset node: exactly one policy, in the slot Croissant 1.1 provides.
#-----------------------------------------------------------------------------

cposh:DatasetShape
    a sh:NodeShape ;
    sh:targetClass sc:Dataset ;
    sh:name "Croissant dataset carrying an ODRL policy" ;

    sh:property [
        sh:path sc:usageInfo ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class odrl:Set ;
        sh:message "The carrier puts exactly one odrl:Set in sc:usageInfo." ;
    ] ;

    # Same clause 2 as the cpol: form, against this carrier's own identifier.
    # Same literal-or-IRI accommodation, for the same Croissant defect.
    sh:property [
        sh:path dct:conformsTo ;
        sh:qualifiedValueShape [
            sh:or ( [ sh:hasValue <http://mlcommons.org/croissant/1.0> ] [ sh:pattern "^http://mlcommons\\.org/croissant/1\\.0$" ] )
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "conformsTo must include <http://mlcommons.org/croissant/1.0>." ;
    ] ;
    sh:property [
        sh:path dct:conformsTo ;
        sh:qualifiedValueShape [
            sh:or ( [ sh:hasValue <https://w3id.org/croissant-policy/0.1.0/odrl> ] [ sh:pattern "^https://w3id\\.org/croissant-policy/0\\.1\\.0/odrl$" ] )
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "conformsTo must include <https://w3id.org/croissant-policy/0.1.0/odrl>, which is not the cpol: identifier." ;
    ] .


#-----------------------------------------------------------------------------
# The policy. odrl:profile is mandatory and is the one fail-closed property
# this carrier inherits rather than argues for: an ODRL processing system that
# does not recognise a profile identifier MUST stop processing the policy
# (Information Model 3.2).
#-----------------------------------------------------------------------------

cposh:SetShape
    a sh:NodeShape ;
    sh:targetClass odrl:Set ;
    sh:name "odrl:Set carrying a Croissant policy" ;

    sh:property [
        sh:path odrl:profile ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <https://w3id.org/croissant-policy/0.1.0/odrl> ;
        sh:message "The policy must declare this profile. An unrecognised identifier stops processing (ODRL Information Model 3.2)." ;
    ] ;

    # No ODRL equivalent, which is why the carrier mints it.
    sh:property [
        sh:path cpolodrl:failClosed ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "cpolodrl:failClosed must be present and true; ODRL has no equivalent." ;
    ] ;

    sh:property [
        sh:path cpolodrl:datasetState ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:minLength 1 ;
        sh:message "The policy must declare the dataset's current lifecycle state." ;
    ] ;

    sh:property [
        sh:path odrl:permission ;
        sh:minCount 1 ;
        sh:class odrl:Permission ;
        sh:message "A policy must declare at least one permission. An empty list is silence, not a refusal." ;
    ] .


#-----------------------------------------------------------------------------
# Permissions and constraints.
#-----------------------------------------------------------------------------

cposh:PermissionShape
    a sh:NodeShape ;
    sh:targetClass odrl:Permission ;
    sh:name "odrl:Permission" ;

    sh:property [
        sh:path odrl:action ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^https://w3id.org/croissant-policy/0.1.0/odrl#action/.+$" ;
        sh:message "An action must be one this profile minted; ODRL core actions name what may be done with a work, not what a pipeline stage does to a dataset." ;
    ] ;

    sh:property [
        sh:path odrl:constraint ;
        sh:class odrl:Constraint ;
    ] .


cposh:ConstraintShape
    a sh:NodeShape ;
    sh:targetClass odrl:Constraint ;
    sh:name "odrl:Constraint" ;

    sh:property [
        sh:path odrl:leftOperand ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A constraint must name exactly one left operand." ;
    ] ;

    # sh:in works here where the cpol: shapes needed sh:pattern, because the
    # operator is an IRI rather than a language-tagged string.
    sh:property [
        sh:path odrl:operator ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in ( <http://www.w3.org/ns/odrl/2/eq> <http://www.w3.org/ns/odrl/2/gteq> <http://www.w3.org/ns/odrl/2/isAnyOf> <http://www.w3.org/ns/odrl/2/lteq> <https://w3id.org/croissant-policy/0.1.0/odrl#isPresent> ) ;
        sh:message "The operator must be one of the five this profile maps: four ODRL core operators and the minted presence test." ;
    ] ;

    sh:property [
        sh:path odrl:rightOperand ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A constraint with nothing to compare against cannot be evaluated, and is refused." ;
    ] .
