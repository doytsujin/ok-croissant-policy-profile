      "@id": "https://w3id.org/croissant-policy/0.1.0",
      "@type": "prof:Profile",
      "dct:title": "Croissant Policy Profile",
      "dct:description": "An additive policy layer for Croissant dataset descriptors. A dataset declares the operations it admits and the conditions under which it admits them, from a closed set of five operators, so that a gate can decide a request from the descriptor alone and leave a record of what it checked.",
      "dct:hasVersion": "0.1.0",
      "dct:publisher": "Alexander Chernov",
      "dct:license": {
        "@id": "https://spdx.org/licenses/Apache-2.0.html"
      },
      "prof:isProfileOf": {
        "@id": "http://mlcommons.org/croissant/1.0"
      },
      "prof:hasToken": "cpol",
      "prof:hasResource": [
        {
          "@id": "https://w3id.org/croissant-policy/0.1.0#specification"
        },
        {
          "@id": "https://w3id.org/croissant-policy/0.1.0#profile-document"
        },
        {
          "@id": "https://w3id.org/croissant-policy/0.1.0#context"
        },
        {
          "@id": "https://w3id.org/croissant-policy/0.1.0#shapes"
        },
        {
          "@id": "https://w3id.org/croissant-policy/0.1.0#shapes-odrl"
        },
        {
          "@id": "https://w3id.org/croissant-policy/0.1.0#validator"
        },
        {
          "@id": "https://w3id.org/croissant-policy/0.1.0#examples"
        },
        {
          "@id": "https://w3id.org/croissant-policy/0.1.0#odrl-carrier"
        },
        {
          "@id": "https://w3id.org/croissant-policy/0.1.0#capabilities"
        }
      ]
    },
    {
      "@id": "https://w3id.org/croissant-policy/0.1.0/odrl",
      "@type": "prof:Profile",
      "dct:title": "Croissant Policy Profile \u2014 ODRL carrier",
      "dct:description": "The same policy expressed as an ODRL Set in sc:usageInfo, the carrier Croissant 1.1 recommends for fine-grained use conditions. Four of the five operators are ODRL core operators; only the presence test is minted, because ODRL defines no existence operator. Decisions are identical to the cpol: carrier, record for record.",
      "dct:hasVersion": "0.1.0",
      "prof:isProfileOf": [
        {
          "@id": "http://mlcommons.org/croissant/1.0"
        },
        {
          "@id": "http://www.w3.org/ns/odrl/2/"
        }
      ],
      "prof:isTransitiveProfileOf": {
        "@id": "https://w3id.org/croissant-policy/0.1.0"
      },
      "prof:hasToken": "cpolodrl"
    },
    {
      "@id": "https://w3id.org/croissant-policy/0.1.0#specification",
      "@type": "prof:ResourceDescriptor",
      "dct:title": "specification",
      "dct:description": "The normative specification: conformance clauses, vocabulary, evaluation and capability projection.",
      "prof:hasRole": {
        "@id": "http://www.w3.org/ns/dx/prof/role/specification"
      },
      "prof:hasArtifact": {
