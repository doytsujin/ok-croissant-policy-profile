  "@type": "sc:Dataset",
  "name": "multi-action-3",
  "description": "conformance_fixture described as a policy-bearing Croissant dataset. State: RECEIVED.",
  "conformsTo": [
    "http://mlcommons.org/croissant/1.0",
    "https://w3id.org/croissant-policy/0.1.0"
  ],
  "version": "1.0.0",
  "creator": {
    "@type": "sc:Organization",
    "name": "conformance-corpus"
  },
  "additionalType": "conformance_fixture",
  "distribution": [
    {
      "@type": "cr:FileSet",
      "@id": "multi-action-3-files",
      "name": "multi-action-3-files",
      "description": "The conformance_fixture files of this dataset, in json form. The native descriptor records the shape of the data and not its location, so this FileSet has no containedIn; the location is supplied by whoever mounts the dataset.",
      "encodingFormat": "application/json",
      "includes": "*.json"
    }
  ],
  "cpol:policy": {
    "@type": "cpol:Policy",
    "cpol:state": "RECEIVED",
    "cpol:failClosed": true,
    "cpol:classification": "synthetic",
    "cpol:custodian": "conformance-corpus",
    "cpol:rationale": "Generated from the profile grammar to exercise a specification case. Not a real dataset and not evidence about real policies.",
    "cpol:permissibleAction": [
      {
        "@type": "cpol:Action",
        "cpol:actionName": "act0",
        "cpol:requiresState": [
          "RECEIVED"
        ],
        "cpol:condition": [
          {
            "@type": "cpol:Condition",
            "cpol:conditionName": "probe",
            "cpol:operator": "cpol:min",
            "cpol:expected": 20
          }
        ]
      },
      {
        "@type": "cpol:Action",
        "cpol:actionName": "act1",
        "cpol:requiresState": [
          "QC_PASSED"
        ],
        "cpol:condition": [
          {
            "@type": "cpol:Condition",
            "cpol:conditionName": "probe",
            "cpol:operator": "cpol:max",
            "cpol:expected": 100
          }
        ]
      },
      {
        "@type": "cpol:Action",
        "cpol:actionName": "act2",
        "cpol:requiresState": [
          "TRIMMED"
        ],
        "cpol:condition": [
          {
            "@type": "cpol:Condition",
            "cpol:conditionName": "probe",
            "cpol:operator": "cpol:in",
            "cpol:expected": [
              "illumina",
              "nanopore"
            ]
          }
        ]
      }
    ]
  }
