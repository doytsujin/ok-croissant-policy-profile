  "@type": "sc:Dataset",
  "name": "operator-in",
  "description": "conformance_fixture described as a policy-bearing Croissant dataset. State: QC_PASSED.",
  "conformsTo": [
    "http://mlcommons.org/croissant/1.0",
    "https://w3id.org/croissant-policy/0.1.0/odrl"
  ],
  "version": "1.0.0",
  "creator": {
    "@type": "sc:Organization",
    "name": "conformance-corpus"
  },
  "additionalType": "conformance_fixture",
  "distribution": [
    {
      "@type": "cr:FileSet",
      "@id": "operator-in-files",
      "name": "operator-in-files",
      "description": "The conformance_fixture files of this dataset, in json form. The native descriptor records the shape of the data and not its location, so this FileSet has no containedIn; the location is supplied by whoever mounts the dataset.",
      "encodingFormat": "application/json",
      "includes": "*.json"
    }
  ],
  "usageInfo": {
    "@type": "odrl:Set",
    "odrl:uid": "operator-in#policy",
    "odrl:profile": {
      "@id": "https://w3id.org/croissant-policy/0.1.0/odrl"
    },
    "cpolodrl:datasetState": "QC_PASSED",
    "cpolodrl:failClosed": true,
    "cpolodrl:classification": "synthetic",
    "cpolodrl:custodian": "conformance-corpus",
    "cpolodrl:rationale": "Generated from the profile grammar to exercise a specification case. Not a real dataset and not evidence about real policies.",
    "odrl:permission": [
      {
        "@type": "odrl:Permission",
        "odrl:action": {
          "@id": "https://w3id.org/croissant-policy/0.1.0/odrl#action/run"
        },
        "odrl:constraint": [
          {
            "@type": "odrl:Constraint",
            "odrl:leftOperand": {
              "@id": "https://w3id.org/croissant-policy/0.1.0/odrl#datasetState"
            },
            "odrl:operator": {
              "@id": "http://www.w3.org/ns/odrl/2/isAnyOf"
            },
            "odrl:rightOperand": [
              "QC_PASSED"
            ]
          },
          {
            "@type": "odrl:Constraint",
            "odrl:leftOperand": {
              "@id": "https://w3id.org/croissant-policy/0.1.0/odrl#ctx/probe"
            },
            "odrl:operator": {
              "@id": "http://www.w3.org/ns/odrl/2/isAnyOf"
            },
            "odrl:rightOperand": [
              "illumina",
              "nanopore"
            ]
          }
        ]
      }
    ]
  }
